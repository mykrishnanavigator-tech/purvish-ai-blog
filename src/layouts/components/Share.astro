---
import config from "@/config/config.json";
import { IoLogoLinkedin, IoLogoTwitter } from "react-icons/io5";

const { base_url }: { base_url: string } = config.site;
const {
  title,
  description,
  slug,
  className,
}: { title?: string; description?: string; slug?: string; className?: string } =
  Astro.props;

const pageUrl = new URL(slug || "", `${base_url}/`).toString();
const twitterShareUrl = `https://twitter.com/intent/tweet/?${new URLSearchParams({
  text: title || "",
  url: pageUrl,
}).toString()}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?${new URLSearchParams({
  url: pageUrl,
}).toString()}`;
---

<ul class={`${className}`}>
  <li class="inline-block">
    <a
      aria-label="twitter share button"
      href={twitterShareUrl}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoTwitter />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="linkedin share button"
      href={linkedinShareUrl}
      data-linkedin-share
      data-share-url={pageUrl}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoLinkedin />
    </a>
  </li>
</ul>

<script>
  document.querySelectorAll("[data-linkedin-share]").forEach((link) => {
    link.addEventListener("click", async (event) => {
      if (!(link instanceof HTMLAnchorElement)) return;

      event.preventDefault();
      const shareWindow = window.open(
        link.href,
        "_blank",
        "noopener,noreferrer,width=720,height=720",
      );

      if (!shareWindow && navigator.clipboard) {
        await navigator.clipboard.writeText(link.dataset.shareUrl || "");
      }
    });
  });
</script>
