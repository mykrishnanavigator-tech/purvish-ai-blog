---
import BlogCard from "@/components/BlogCard.astro";
import Share from "@/components/Share.astro";
import config from "@/config/config.json";
import Disqus from "@/helpers/Disqus";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similarItems from "@/lib/utils/similarItems";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import { FaRegClock, FaRegFolder, FaRegUserCircle } from "react-icons/fa";
import ImageMod from "./components/ImageMod.astro";

const COLLECTION_FOLDER = "blog";
const { post } = Astro.props;

const posts = await getSinglePage(COLLECTION_FOLDER);
const similarPosts = similarItems(post, posts);
const { Content } = await render(post);
const {
  title,
  description,
  author,
  categories,
  image,
  date,
  app_store_banner,
  banner,
  banner_bg,
} = post.data;
---

<section class="section pt-7">
  <div class="container">
    <div class="row justify-center">
      <article class="lg:col-10">
        {
          app_store_banner ? (
            <div class="mb-10">
              <div class={`my-8 flex flex-col gap-5 rounded-lg p-6 sm:flex-row sm:items-center ${banner_bg === 'gray' ? 'bg-gray-100 dark:bg-gray-800' : 'bg-light dark:bg-darkmode-light'}`}>
                <a
                  href="https://apps.apple.com/us/app/my-krishna/id6782722854"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    src="/images/my-krishna-ios-icon.png"
                    alt="My Krishna iOS app icon"
                    width="128"
                    height="128"
                    class="mx-auto h-32 w-32 rounded-3xl sm:mx-0"
                  />
                </a>
                <div>
                  <h2 class="mb-2 text-2xl">Try My Krishna on iOS</h2>
                  <p class="mb-4">
                    Ask a question, start a conversation, and reflect with
                    guidance inspired by Krishna's teachings.
                  </p>
                  <a
                    class="btn btn-primary"
                    href="https://apps.apple.com/us/app/my-krishna/id6782722854"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Download on the App Store
                  </a>
                </div>
              </div>
            </div>
          ) : (
            banner ? (
              <div class={`mb-10 rounded-lg p-8 ${banner_bg === 'gray' ? 'bg-gray-100 dark:bg-gray-800' : 'bg-light dark:bg-darkmode-light'}`}>
                <h1 set:html={markdownify(title)} class="h2 mb-4 text-center" />
              </div>
            ) : (
              image && (
                <div class="mb-10">
                  <ImageMod
                    src={image}
                    height={500}
                    width={1200}
                    alt={title}
                    class="w-full rounded"
                    format="webp"
                  />
                </div>
              )
            )
          )
        }
        { !banner && <h1 set:html={markdownify(title)} class="h2 mb-4" /> }
        <ul class="mb-4">
          <li class="mr-4 inline-block">
            <a href={`/authors/${slugify(author)}`}>
              <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
              {humanize(author)}
            </a>
          </li>
          <li class="mr-4 inline-block">
            <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
            {
              categories.map((category: string, index: number) => (
                <a href={`/categories/${slugify(category)}`}>
                  {humanize(category)}
                  {index !== categories.length - 1 && ","}
                </a>
              ))
            }
          </li>
          <li class="mr-4 inline-block">
            <FaRegClock className={"mr-2 -mt-1 inline-block"} />
            {dateFormat(date)}
          </li>
        </ul>
        <div class="content mb-10">
          <Content />
        </div>
        <div class="row items-start justify-between">
          <div class="flex items-center lg:col-4">
            <h5 class="mr-3">Share :</h5>
            <Share
              className="social-icons"
              title={title}
              description={description}
              slug={`${COLLECTION_FOLDER}/${post.id}`}
            />
          </div>
        </div>
        {config.disqus.enable && <Disqus className="mt-20" client:only="react" />}
      </article>
    </div>

    <!-- Related posts -->
    <div class="section pb-0">
      <h2 class="h3 mb-12 text-center">Related Posts</h2>
      <div class="row justify-center">
        {
          similarPosts.map((post) => (
            <div class="lg:col-4 md:col-6 mb-14">
              <BlogCard data={post} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
